---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	canonical?: string;
	ogImage?: string;
	article?: boolean;
	schema?: Record<string, unknown>;
	noindex?: boolean;
}

const { title, description, canonical, ogImage, article, schema, noindex } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/logo.jpg" />
		<link rel="alternate" type="application/rss+xml" title="机场 Pro" href="/rss.xml" />
		<meta name="theme-color" content="#0284c7" />
		<SEO 
			title={title}
			description={description}
			canonical={canonical}
			ogImage={ogImage}
			article={article}
			schema={schema}
			noindex={noindex}
		/>
	</head>
	<body>
		<a href="#main-content" class="skip-link">跳到正文</a>
		<Header />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
		<script>
			// 全站优惠码一键复制：给元素加 class="copy-code" 和 data-code="优惠码" 即可
			document.addEventListener('click', (e) => {
				const target = (e.target as HTMLElement | null)?.closest<HTMLElement>('.copy-code');
				const code = target?.dataset.code;
				if (!target || !code || target.dataset.copied) return;
				navigator.clipboard.writeText(code).then(() => {
					const originalHtml = target.innerHTML;
					target.dataset.copied = '1';
					target.innerHTML = '已复制 ✔️';
					setTimeout(() => {
						target.innerHTML = originalHtml;
						delete target.dataset.copied;
					}, 2000);
				});
			});
		</script>
	</body>
</html>

