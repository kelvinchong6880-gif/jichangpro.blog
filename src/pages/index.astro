---
import Layout from '../layouts/Layout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import BrandLogo from '../components/BrandLogo.astro';
import FaqList from '../components/FaqList.astro';
import { getAirports, getPlanStats } from '../utils/data';
import { faqPage, graph, organization, organizationRef, type Faq } from '../utils/schema';
import { siteConfig } from '../config';

const airports = await getAirports();
const sogo = airports.find(a => a.id === 'sogo');
const sogoStats = sogo ? getPlanStats(sogo) : null;
const count = airports.length;
const updated = siteConfig.lastUpdated;
const [uy, um] = updated.split('-');
const updatedLabel = `${uy}年${Number(um)}月`;

const ranked = airports.map((a, i) => ({
  rank: i + 1,
  a,
  stats: getPlanStats(a),
  blurb: { fit: a.fit ?? '多数用户', note: a.summary ?? a.intro },
}));

// 按需求快速推荐（根据数据自动计算）
const withMonthly = ranked.filter(r => r.stats.minMonthly !== null);
const cheapest = [...withMonthly].sort((x, y) => (x.stats.minMonthly! - y.stats.minMonthly!))[0];
const bestPerGb = [...withMonthly].sort((x, y) => (x.stats.entryPerGb! - y.stats.entryPerGb!))[0];
const biggest = [...ranked].filter(r => r.stats.maxTraffic !== null).sort((x, y) => (y.stats.maxTraffic! - x.stats.maxTraffic!))[0];
const cheapestYearly = [...ranked].filter(r => r.stats.minYearlySmall !== null).sort((x, y) => (x.stats.minYearlySmall!.price - y.stats.minYearlySmall!.price))[0];
const cheapestOneTime = [...ranked].filter(r => r.stats.minOneTime !== null).sort((x, y) => (x.stats.minOneTime!.price - y.stats.minOneTime!.price))[0];

const faqs: Faq[] = [
  {
    q: '2026 年哪个机场最好用？',
    a: `没有对所有人都“最好”的机场，取决于预算和用途。预算有限可以看月付 18–20 元档（如${cheapest?.a.name ?? '极连云'}、二猫云、一翻云）；需要大流量看月付 45 元以上的中高档套餐；用得少可以选不限时流量包。本站主推 Sogo 云，因为它的月付、年付小包和不限时套餐最齐全，方便按需选择。建议先买一个月实测再决定。`,
  },
  {
    q: '机场和 VPN 有什么区别？',
    a: '机场是提供代理节点订阅的服务商，需要配合 Clash、Shadowrocket、v2rayN 等客户端使用，支持规则分流（国内网站直连、境外网站走代理）；传统 VPN 一般用自家 App 接管全部流量。国内用户常用的是机场，价格更低、线路针对国内网络做了优化。',
  },
  {
    q: '便宜的机场能用吗？',
    a: '可以。月付 20–25 元档已经能满足大多数人的日常需求（每月 100–160GB）。真正需要警惕的是月付几元却宣称“全专线不限量”的机场，以及只能年付、没有月付选项的陌生机场。',
  },
  {
    q: '买机场选月付还是年付？',
    a: '第一次买一律建议月付。用了 1–3 个月确认晚高峰稳定后，再考虑季付或年付。年付单价更低，但机场一旦停止运营，剩余费用很难追回。',
  },
  {
    q: '什么是 IPLC / IEPL 专线机场？',
    a: 'IPLC 和 IEPL 都是跨境私有线路，流量不经过拥堵的公网国际出口，晚高峰和敏感时期更稳定。目前多数机场都宣称专线，是否属实需要通过延迟稳定性和晚高峰测速来判断。',
  },
  {
    q: '一个月需要多少流量？',
    a: '只查资料、用 AI 工具：每月 30–80GB；每天看 YouTube 1080p 约 1 小时：每月 60–100GB；经常看 4K 或 Netflix：每月 300GB 以上。不确定的话先买 150GB 左右的月付，月底看实际用量再调整。',
  },
  {
    q: '怎么降低机场“跑路”的风险？',
    a: '优先月付、不要一次买多年；选择运营时间长、有工单和公告渠道的机场；准备一个不限时流量包的备用机场；不要把大量余额长期存放在机场账户里。',
  },
  {
    q: '机场支持哪些设备和客户端？',
    a: '本站收录的机场都支持 Clash 系列（Windows / macOS / 安卓）和 Shadowrocket（iPhone / iPad），多数也支持 v2rayN。具体支持情况见各品牌评测页。',
  },
];

const siteUrl = siteConfig.url;
const schema = graph(
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "name": siteConfig.name,
    "url": `${siteUrl}/`,
    "inLanguage": "zh-CN",
    "description": siteConfig.description,
    "publisher": organizationRef
  },
  organization(),
  {
    "@type": "WebPage",
    "@id": `${siteUrl}/#webpage`,
    "url": `${siteUrl}/`,
    "name": `${uy}年机场推荐：${count}家翻墙机场套餐对比与排行`,
    "isPartOf": { "@id": `${siteUrl}/#website` },
    "dateModified": updated,
    "inLanguage": "zh-CN"
  },
  {
    "@type": "ItemList",
    "name": `${uy}年机场推荐榜单`,
    "itemListOrder": "https://schema.org/ItemListOrderAscending",
    "numberOfItems": count,
    "itemListElement": ranked.map(r => ({
      "@type": "ListItem",
      "position": r.rank,
      "name": r.a.name,
      "url": `${siteUrl}/reviews/${r.a.reviewSlug}/`
    }))
  },
  faqPage(faqs)
);
---

<Layout
  title={`机场推荐${uy}：${count}家翻墙机场套餐对比与排行（每月更新）| 机场 Pro`}
  description={`${uy}年最新机场推荐：整理 Sogo 云、飞猫云、光速云等 ${count} 家翻墙机场的月付价格、流量、专线线路与优惠码，附便宜/稳定/性价比分类榜单和新手选购指南，每月核对更新。`}
  schema={schema}
>
  <section class="hero">
    <div class="hero-title-group">
      <img src="/logo.jpg" alt="机场 Pro" class="hero-logo" width="64" height="64" />
      <h1>{uy}年机场推荐<span class="h1-sub">{count}家翻墙机场套餐对比与排行</span></h1>
    </div>
    <p class="updated-line">最后更新：<time datetime={updated}>{updated}</time> · 价格每月核对 · 编辑：机场 Pro 编辑部</p>
    <p class="subtitle">机场 Pro 是一个专注<strong>翻墙机场推荐</strong>与对比的中文网站。我们把各家机场的月付价格、每月流量、年付小包、不限时套餐和线路类型整理成同一张表，帮你在几分钟内选到合适的科学上网服务。</p>

    <div class="quick-links">
      <a href="/cheap/" class="card-link">
        <div class="card-link-icon">💎</div>
        <h2 class="card-h">便宜机场推荐 &rarr;</h2>
        <p>月付 25 元以内、年付小包、低预算首选</p>
      </a>
      <a href="/stable/" class="card-link">
        <div class="card-link-icon">🛡️</div>
        <h2 class="card-h">稳定机场推荐 &rarr;</h2>
        <p>IPLC/IEPL 专线，工作、外贸、晚高峰</p>
      </a>
      <a href="/value/" class="card-link">
        <div class="card-link-icon">⚖️</div>
        <h2 class="card-h">性价比机场推荐 &rarr;</h2>
        <p>价格与流量的平衡点</p>
      </a>
    </div>
  </section>

  {sogo && sogoStats && (
    <section class="featured-sogo" aria-label="本站主推机场">
      <div class="featured-badge">本站主推</div>
      <div class="sogo-compact-layout">
        <div class="sogo-brand-col">
          <div style="display: flex; align-items: center; gap: 10px;">
            <BrandLogo
              brandName={sogo.name}
              squareSrc={sogo.logo?.square}
              width={36}
              height={36}
              hideAlt={true}
            />
            <h2>{sogo.name}</h2>
          </div>
          <p class="sogo-intro-text">官网宣称：全线 IPLC/IEPL 专线、不限设备数、原生 IP 解锁主流流媒体与 AI 工具。月付、年付小包、不限时流量包三种套餐都有。</p>
        </div>

        <div class="sogo-price-col">
          <div class="price-highlight">
            <span class="amount">¥{sogoStats.minMonthly}</span><span class="unit">/月起</span>
          </div>
          {sogo.promoCode && (
            <div class="promo-compact">
              <span class="promo-label">优惠码:</span>
              <code class="promo-code copy-code" data-code={sogo.promoCode} title="点击复制">{sogo.promoCode} <span class="copy-icon">📋</span></code>
            </div>
          )}
        </div>

        <div class="sogo-action-col">
          {sogo.promoLink && <a href={sogo.promoLink} target="_blank" rel="sponsored noopener noreferrer" class="btn btn-primary">前往注册</a>}
          <a href="/reviews/sogo/" class="btn btn-secondary">Sogo 云评测</a>
        </div>
      </div>
      <p class="disclosure-mini">*Sogo 云为本站主推品牌，与本站存在推广合作关系，上方链接含推广参数。“专线”“解锁”等为服务商宣称，本站正在补充实测数据，具体体验请以实际为准。</p>
    </section>
  )}

  <section class="content-section">
    <h2>按需求快速选：一张表看懂该买哪家</h2>
    <p>如果你没时间看完整榜单，可以直接按自己的情况对号入座（数据根据各家官网套餐自动计算，价格以官网为准）：</p>
    <div class="table-scroll">
      <table class="pick-table">
        <thead>
          <tr><th>你的情况</th><th>推荐</th><th>理由</th></tr>
        </thead>
        <tbody>
          {sogo && sogoStats && (
            <tr><td>不想纠结，要一家全都有</td><td><a href="/reviews/sogo/">{sogo.name}</a></td><td>月付 ¥{sogoStats.minMonthly} 起，另有年付小包与 4 档不限时包，本站主推</td></tr>
          )}
          {cheapest && (
            <tr><td>预算最低，按月付</td><td><a href={`/reviews/${cheapest.a.reviewSlug}/`}>{cheapest.a.name}</a></td><td>月付 ¥{cheapest.stats.minMonthly} 起（{cheapest.stats.entryTraffic}GB/月），收录品牌中最低</td></tr>
          )}
          {bestPerGb && (
            <tr><td>入门档每 GB 最便宜</td><td><a href={`/reviews/${bestPerGb.a.reviewSlug}/`}>{bestPerGb.a.name}</a></td><td>入门月付 ¥{bestPerGb.stats.minMonthly} / {bestPerGb.stats.entryTraffic}GB，约 ¥{bestPerGb.stats.entryPerGb?.toFixed(3)}/GB</td></tr>
          )}
          {cheapestYearly && (
            <tr><td>用得少，愿意一次付一年</td><td><a href={`/reviews/${cheapestYearly.a.reviewSlug}/`}>{cheapestYearly.a.name}</a></td><td>年付小包 ¥{cheapestYearly.stats.minYearlySmall?.price}/年（{cheapestYearly.stats.minYearlySmall?.traffic}GB/月），折合约 ¥{(cheapestYearly.stats.minYearlySmall!.price / 12).toFixed(1)}/月</td></tr>
          )}
          {cheapestOneTime && (
            <tr><td>偶尔用，不想按月付费</td><td><a href={`/reviews/${cheapestOneTime.a.reviewSlug}/`}>{cheapestOneTime.a.name}</a></td><td>不限时流量包 ¥{cheapestOneTime.stats.minOneTime?.price} / {cheapestOneTime.stats.minOneTime?.traffic}GB，用完为止</td></tr>
          )}
          {biggest && (
            <tr><td>重度用户，流量越多越好</td><td><a href={`/reviews/${biggest.a.reviewSlug}/`}>{biggest.a.name}</a></td><td>最高月付套餐 {biggest.stats.maxTraffic}GB/月</td></tr>
          )}
        </tbody>
      </table>
    </div>
  </section>

  <section class="content-section">
    <h2>{uy}年机场推荐榜单（{updatedLabel}更新）</h2>
    <p>以下是本站收录的 {count} 家机场。排序为编辑推荐顺序，综合考虑了套餐完整度、入门价格、流量和官网公开资料，<strong>不代表实测稳定性排名</strong>；部分注册链接含推广参数，详见 <a href="/disclosure/">利益披露</a>。</p>

    <ol class="rank-list">
      {ranked.map(({ rank, a, stats, blurb }) => (
        <li class="rank-card" id={`rank-${a.id}`}>
          <div class="rank-head">
            <span class="rank-no">{rank}</span>
            <BrandLogo brandName={a.name} squareSrc={a.logo?.square} width={40} height={40} hideAlt={true} />
            <h3><a href={`/reviews/${a.reviewSlug}/`}>{a.name}</a></h3>
            <span class="rank-tags">{a.tags.slice(0, 3).map(t => <span class="tag">{t}</span>)}</span>
          </div>
          <dl class="rank-facts">
            <div><dt>月付起价</dt><dd>{stats.minMonthly !== null ? `¥${stats.minMonthly}（${stats.entryTraffic}GB）` : '—'}</dd></div>
            <div><dt>年付小包</dt><dd>{stats.minYearlySmall ? `¥${stats.minYearlySmall.price}/年（${stats.minYearlySmall.traffic}GB/月）` : '—'}</dd></div>
            <div><dt>不限时包</dt><dd>{stats.minOneTime ? `¥${stats.minOneTime.price} 起（${stats.minOneTime.traffic}GB）` : '无'}</dd></div>
            <div><dt>最大月流量</dt><dd>{stats.maxTraffic !== null ? `${stats.maxTraffic}GB` : '—'}</dd></div>
          </dl>
          <p class="rank-note"><strong>适合：</strong>{blurb.fit}。{blurb.note}</p>
          <div class="rank-actions">
            <a href={`/reviews/${a.reviewSlug}/`} class="btn btn-secondary">{a.name}评测</a>
            {a.promoLink && <a href={a.promoLink} target="_blank" rel="sponsored noopener noreferrer" class="btn btn-primary">官网注册</a>}
            {a.promoCode && <span class="rank-code">优惠码 <code>{a.promoCode}</code></span>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="content-section">
    <h2>机场综合对比表</h2>
    <p>点击表头可按月付价格、年付价格、流量排序，也可以按标签筛选。想看更多字段，请打开 <a href="/compare/">完整机场综合对比表</a>。</p>
    <ComparisonTable airports={airports} />
  </section>

  <section class="content-section prose-wide">
    <h2>怎么选机场？5 条新手选购原则</h2>
    <ol class="guide-list">
      <li><strong>先确定用途和流量。</strong>只查资料和用 AI 工具，每月 30–80GB 就够；每天看 YouTube 建议 100GB 以上；经常看 4K 或 Netflix 选 300GB 以上。</li>
      <li><strong>第一次只买月付。</strong>机场行业有停运风险，月付是试错成本最低的方式。用 1–3 个月确认稳定后再考虑年付。</li>
      <li><strong>看清“真实月付”和“折合月付”。</strong>“每月 8 元”通常是年付小包折算出来的，需要一次付 90–100 元。详见 <a href="/tutorials/understand-pricing-plans/">如何看懂机场套餐</a>。</li>
      <li><strong>晚高峰测速才算数。</strong>晚上 8–11 点打开 YouTube 1080p/4K，看是否流畅；延迟忽高忽低、大面积超时的机场要谨慎。</li>
      <li><strong>专线要实测验证。</strong>几乎所有机场都宣称 IPLC/IEPL，判断方法见 <a href="/tutorials/iplc-iepl-difference/">IPLC 和 IEPL 专线有什么区别</a>。</li>
    </ol>
    <p>完整步骤请看：<a href="/tutorials/how-to-choose/">如何选择机场：预算、流量、线路与测试方法</a>。刚入门的朋友可以先读 <a href="/tutorials/what-is-jichang/">机场是什么</a>。</p>
  </section>

  <section class="content-section about-method">
    <h2>我们的整理方法与更新机制</h2>
    <div class="method-grid">
      <div class="method-card">
        <h3>资料来源</h3>
        <p>套餐价格、流量和线路说明来自各机场官网公开信息。“专线”“不限速”“解锁”等均为服务商宣称，本站会明确标注，不当作实测结论。</p>
      </div>
      <div class="method-card">
        <h3>定期核对</h3>
        <p>每月核对一次各家官网套餐与价格，并在页面顶部和对比表中显示核验日期。未知数据一律标注“未知”，不凭空推断。详见 <a href="/methodology/">测试方法</a>。</p>
      </div>
      <div class="method-card">
        <h3>利益披露</h3>
        <p>榜单顺序为编辑主观整理，部分注册链接带推广参数，我们可能因此获得佣金，但不影响客观数据展示。阅读 <a href="/disclosure/">完整披露</a>。</p>
      </div>
    </div>
  </section>

  <FaqList faqs={faqs} title="机场推荐常见问题（FAQ）" collapsible={true} />

  <section class="content-section closing">
    <p>机场 Pro 会持续补充各家机场的晚高峰实测与流媒体解锁数据。下一步可以看：<a href="/cheap/">便宜机场推荐</a> · <a href="/stable/">稳定机场推荐</a> · <a href="/value/">性价比机场推荐</a> · <a href="/reviews/">全部机场评测</a> · <a href="/coupons/">机场优惠码</a> · <a href="/tutorials/">使用教程</a></p>
  </section>

</Layout>



<style>

  .hero {
    text-align: center;
    padding: 3rem 0 5rem;
    position: relative;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -50px;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 400px;
    background: radial-gradient(circle at top, #e0f2fe 0%, transparent 60%);
    z-index: -1;
    pointer-events: none;
  }
  .hero-title-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }
  .hero-logo {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    object-fit: contain;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
  }
  @media (max-width: 768px) {
    .hero-title-group {
      flex-direction: column;
      gap: 0.75rem;
    }
    .hero-logo {
      width: 56px;
      height: 56px;
    }
  }
  .hero h1 {
    font-size: 2.5rem;
    line-height: 1.2;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.03em;
    margin: 0;
  }
  .hero h1 span {
    background: linear-gradient(135deg, var(--color-primary), #0ea5e9);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  @media (max-width: 768px) {
    .hero h1 { font-size: 1.875rem; }
  }
  .subtitle {
    font-size: 1.125rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto 3rem;
    line-height: 1.7;
  }
  
  .quick-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .card-link {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    text-align: left;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: var(--color-bg);
    position: relative;
    overflow: hidden;
  }
  .card-link:hover {
    border-color: #bae6fd;
    box-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.1), 0 8px 10px -6px rgba(2, 132, 199, 0.1);
    text-decoration: none;
    transform: translateY(-4px);
  }
  .card-link-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1;
  }
  .card-link h3 {
    margin: 0 0 0.5rem 0;
    color: var(--color-text);
    font-size: 1.25rem;
    font-weight: 600;
    transition: color 0.2s;
  }
  .card-link:hover h3 {
    color: var(--color-primary);
  }
  .card-link p {
    margin: 0;
    color: var(--color-text-light);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

